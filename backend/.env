# ==============================================================================
# CareAgent — Environment Configuration (.env)
# ==============================================================================
# Put your Gemini or Groq API key here:
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# ==============================================================================

# --- AI & LLM Provider Keys ---
# Get your Google Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# (Optional) Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Security & JWT Settings ---
SECRET_KEY=careagent_super_secret_jwt_key_2026_healthcare_phi
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Storage ---
DATABASE_URL=sqlite:///./careagent.db

# --- Application Environment ---
ENVIRONMENT=development
PROJECT_NAME="CareAgent — Agentic AI Hospital Assistant"
