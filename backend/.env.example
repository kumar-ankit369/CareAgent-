# ==============================================================================
# CareAgent — Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`:
#      cp backend/.env.example backend/.env
# 2. Add your Gemini or Groq API key below (if desired).
#    CareAgent also includes a full offline clinical rules engine that operates
#    without any API key!
# ==============================================================================

# --- AI & LLM Provider Keys ---
# Get your Google Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# (Optional) Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Security & JWT Settings ---
# Generate a strong 32+ character random secret for production
SECRET_KEY=careagent_super_secret_jwt_key_2026_healthcare_phi
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Storage ---
DATABASE_URL=sqlite:///./careagent.db

# --- Application Environment ---
ENVIRONMENT=development
PROJECT_NAME="CareAgent — Agentic AI Hospital Assistant"
